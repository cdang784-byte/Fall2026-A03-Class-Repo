@* added notes *@

@page "/checkout/payment"
@inject NavigationManager Navigation

<PageTitle>Checkout - Payment</PageTitle>

<h1>Checkout: Payment</h1>

<div class="card mt-3">
    <div class="card-body">
        <h5 class="card-title">Step 2 of 3: Payment Details</h5>

        <div class="mb-3">
            <label class="form-label">Card Number</label>
            <input type="text" class="form-control" placeholder="4111 1111 1111 1111" />
        </div>
        <div class="row mb-3">
            <div class="col">
                <label class="form-label">Expiry</label>
                <input type="text" class="form-control" placeholder="MM/YY" />
            </div>
            <div class="col">
                <label class="form-label">CVV</label>
                <input type="text" class="form-control" placeholder="123" />
            </div>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary" @onclick="GoBack">
                &larr; Back
            </button>
            <button class="btn btn-primary" @onclick="ReviewOrder">
                Review Order &rarr;
            </button>
        </div>

        <p class="text-muted mt-2">
            <small>The Back button uses <code>replace: true</code> so the browser's back button
            skips this page and returns directly to shipping.</small>
        </p>
    </div>
</div>

@code {
    private void GoBack()
    {
        Navigation.NavigateTo("/checkout/shipping", replace: true); // this will navigate back to the shipping page, but it will replace the current entry in the browser's history, so the user won't return to this payment page when they click the back button in their browser.
        // replace: true means that the current page will be replaced in the browser's history stack, so when the user clicks the back button, they will go back to the shipping page instead of returning to this payment page.
    }

    private void ReviewOrder()
    {
        Navigation.NavigateTo("/checkout/confirm"); // this will navigate to the confirmation page, where the user can review their order before submitting it.
    }
}
