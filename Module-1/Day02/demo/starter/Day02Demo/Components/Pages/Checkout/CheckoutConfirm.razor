@* added notes *@

@page "/checkout/confirm"
@inject NavigationManager Navigation

<PageTitle>Checkout - Confirmation</PageTitle>

<h1>Checkout: Confirmation</h1>

<div class="card mt-3">
    <div class="card-body">
        <h5 class="card-title">Step 3 of 3: Review Your Order</h5>

        <div class="alert alert-success">
            Order ready for submission. In a real application, this page would display
            the shipping and payment details collected in steps 1 and 2.
        </div>

        <p>
            <strong>Key takeaway:</strong> Each step used <code>NavigateTo()</code> to advance
            the user through the wizard. The code decided where to go next -- not a link click.
        </p>

        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary" @onclick="GoBack">
                &larr; Back to Payment
            </button>
            <button class="btn btn-success" @onclick="StartOver">
                Start Over
            </button>
        </div>
    </div>
</div>

@code {
    private void GoBack()
    {
        Navigation.NavigateTo("/checkout/payment", replace: true); // this will navigate back to the payment page, but it will replace the current entry in the browser's history, so the user won't return to this confirmation page when they click the back button in their browser.
    }

    private void StartOver()
    {
        Navigation.NavigateTo("/checkout/shipping"); // this will navigate back to the shipping page, starting the checkout process over from the beginning.
    }
}
